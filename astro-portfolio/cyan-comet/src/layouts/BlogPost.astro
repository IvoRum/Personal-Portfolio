---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
} = Astro.props;

const heroSrc = heroImage
  ? heroImage.startsWith("http") || heroImage.startsWith("/")
    ? heroImage
    : `/${heroImage}`
  : undefined;
---

<html lang="en">
  <head>
    <meta property="og:image" content={heroSrc} />
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
      .hero-image {
        width: 100%;
        max-width: 1120px;
        margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
        padding: 0 clamp(1rem, 4vw, 2rem);
      }
      .hero-image img {
        display: block;
        width: 100%;
        max-height: 520px;
        object-fit: cover;
        filter: saturate(0.88) brightness(0.97);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06),
          0 40px 90px -55px rgba(0, 0, 0, 0.95);
      }
      .prose {
        width: min(760px, 100% - 2.5rem);
        margin: 0 auto;
        padding: clamp(2rem, 4vw, 3rem) 0 2rem;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--text-muted);
      }
      .title {
        margin-bottom: clamp(2rem, 4vw, 3rem);
        padding-bottom: 1.75rem;
        text-align: left;
        line-height: 1.1;
        border-bottom: 1px solid var(--border);
      }
      .date {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.9rem;
        margin-bottom: 1.1rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-dim);
      }
      .date > :global(time) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.32rem 0.7rem;
        color: #dbe6e8;
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
      }
      .date > :global(time)::before {
        content: "";
        width: 5px;
        height: 5px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 50%;
      }
      .last-updated-on {
        font-style: normal;
      }
      .title h1 {
        margin: 0.2rem 0 0;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        line-height: 1.06;
        letter-spacing: -0.035em;
      }
      .title hr {
        width: 4rem;
        height: 3px;
        margin: 1.5rem 0 0;
        border: 0;
        border-radius: 999px;
        background: var(--accent-gradient);
      }
      @media (max-width: 720px) {
        .hero-image {
          padding: 0 1rem;
        }
        .prose {
          width: calc(100% - 2rem);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <img
                width={1020}
                height={510}
                src={heroSrc}
                alt=""
              />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on{" "}
                    <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
